# Docker demo environment for Clarif.
#
# Committed on purpose so `docker compose up --build` works in a clean checkout
# with no manual setup. These are DEMO/LOCAL values: the credentials and the
# APP_KEY below are not secret and must not be reused for a real production
# deployment.

APP_NAME=Clarif
APP_ENV=production
APP_KEY=base64:zUqyWTBRL8ZdNtLxxUGFf4f6WNgrOAfswDwWILcjuyY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Let the built-in PHP server handle a few concurrent requests.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# In Docker, PostgreSQL is reached through the service name, never localhost.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clarif
DB_USERNAME=clarif
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Clarif"

VITE_APP_NAME="Clarif"
