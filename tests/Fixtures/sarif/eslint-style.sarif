{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "version": "8.57.0",
          "rules": [
            {
              "id": "no-unused-vars",
              "defaultConfiguration": { "level": "error" }
            },
            {
              "id": "no-console",
              "defaultConfiguration": { "level": "warning" }
            },
            {
              "id": "eqeqeq"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "no-unused-vars",
          "message": { "text": "'foo' is defined but never used." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/index.js" },
                "region": { "startLine": 12 }
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    { "location": { "physicalLocation": { "artifactLocation": { "uri": "src/index.js" }, "region": { "startLine": 4 } } } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "no-console",
          "level": "note",
          "message": { "text": "Unexpected console statement." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/app.js" },
                "region": { "startLine": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "eqeqeq",
          "message": { "text": "Expected '===' and instead saw '=='." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/utils.js" },
                "region": { "startLine": 42 }
              }
            }
          ]
        },
        {
          "ruleId": "unknown-rule",
          "message": { "text": "Mystery result with no level anywhere." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/mystery.js" },
                "region": { "startLine": 7 }
              }
            }
          ]
        }
      ]
    }
  ]
}
